        ],
        "url": {
          "raw": "{{baseUrl}}/lotes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lotes"
          ]
        },
        "description": "Lotes recentes do contribuinte autenticado."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Listar documentos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Cnpj",
            "value": "{{cnpj}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documentos?tamanho=20&pagina=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documentos"
          ],
          "query": [
            {
              "key": "tamanho",
              "value": "20"
            },
            {
              "key": "pagina",
              "value": "1"
            },
            {
              "key": "dataInicio",
              "value": "2026-01-01T00:00:00Z",
              "disabled": true
            },
            {
              "key": "dataFim",
              "value": "2026-12-31T23:59:59Z",
              "disabled": true
            },
            {
              "key": "documentoDestinatario",
              "value": "52998224725",
              "disabled": true
            },
            {
              "key": "uf",
              "value": "SP",
              "disabled": true
            }
          ]
        },
        "description": "Listagem paginada. Os filtros extras estao desativados: ative os que quiser.\n\nRepare que o CPF do destinatario vem MASCARADO aqui — o valor integro so aparece no detalhe."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const p = pm.response.json();",
              "console.log('total: ' + p.total);",
              "if (p.itens.length) {",
              "    pm.test('CPF vem mascarado na listagem', () =>",
              "        pm.expect(p.itens[0].documentoDestinatario || '*').to.include('*'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Detalhe do documento",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Cnpj",
            "value": "{{cnpj}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documentos/{{documentoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documentos",
            "{{documentoId}}"
          ]
        },
        "description": "Traz os itens e o CPF/CNPJ do destinatario INTEGRO. Devolve ETag, que fica salvo para a proxima requisicao."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('CPF integro no detalhe', () =>",
              "    pm.expect(d.documentoDestinatario).to.eql('52998224725'));",
              "pm.test('dois itens', () => pm.expect(d.itens).to.have.lengthOf(2));",
              "const etag = pm.response.headers.get('ETag');",
              "if (etag) { pm.collectionVariables.set('etag', etag); }",
              "console.log('ETag salvo: ' + etag);"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Detalhe com If-None-Match",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          },
          {
            "key": "X-Cnpj",
            "value": "{{cnpj}}"
          },
          {
            "key": "If-None-Match",
            "value": "{{etag}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documentos/{{documentoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documentos",
            "{{documentoId}}"
          ]
        },
        "description": "Reenvia o ETag da requisicao anterior. Como nada mudou, a resposta e 304 sem corpo — o documento nao trafega de novo."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('304 Not Modified', () => pm.response.to.have.status(304));"
            ]
          }
        }
      ]
    },
