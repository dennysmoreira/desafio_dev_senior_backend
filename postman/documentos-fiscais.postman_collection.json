            "value": "{{apiKey}}"
          },
          {
            "key": "X-Cnpj",
            "value": "{{cnpj}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/documentos/{{documentoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "documentos",
            "{{documentoId}}"
          ]
        },
        "description": "Unico campo alteravel. Chave de acesso, emitente, valores e itens sao imutaveis por construcao — nao existe caminho no codigo para sobrescreve-los.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"observacao\": \"conferido com o pedido 4471\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
