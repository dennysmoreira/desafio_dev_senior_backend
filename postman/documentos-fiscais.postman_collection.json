              "pm.test('observacao gravada', () =>",
              "    pm.expect(d.observacao).to.eql('conferido com o pedido 4471'));",
              "pm.test('o documento fiscal nao se moveu', () => {",
              "    pm.expect(d.valorTotal).to.eql(300.00);",
              "    pm.expect(d.itens).to.have.lengthOf(2);",
              "});"
            ]
          }
        }
      ]
    },
